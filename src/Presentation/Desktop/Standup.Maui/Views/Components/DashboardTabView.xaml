<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             xmlns:models="clr-namespace:Standup.Application.Models;assembly=Standup.Application"
             xmlns:entities="clr-namespace:Standup.Domain.Entities;assembly=Standup.Domain"
             x:Class="Standup.Maui.Views.Components.DashboardTabView"
             x:DataType="viewModels:DashboardViewModel">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Padding="24" RowSpacing="20">

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="📊"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    <Label Text="{Binding SelectedGroup.Name, StringFormat='{0} Dashboard'}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                </VerticalStackLayout>

                <!-- Period Badge -->
                <Border Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#1E3A5F, Dark=#1E3A5F}"
                        StrokeShape="RoundRectangle 20"
                        Padding="16,8"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Label Text="{Binding PeriodDisplay}"
                           FontSize="13"
                           TextColor="#60A5FA" />
                </Border>
            </Grid>

            <!-- Row 1: Metric Cards -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <!-- Total Commits Card -->
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        StrokeThickness="0">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0"
                               Text="TOTAL COMMITS"
                               FontSize="11"
                               TextColor="#94A3B8"
                               CharacterSpacing="0.5" />
                        <Label Grid.Row="1"
                               Text="{Binding TotalCommits}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#60A5FA"
                               Margin="0,8,0,0" />
                        <Label Grid.Row="2"
                               Text="{Binding ActiveProjectCount, StringFormat='{0} projects'}"
                               FontSize="12"
                               TextColor="#94A3B8"
                               Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <!-- Lines Added Card -->
                <Border Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        StrokeThickness="0">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0"
                               Text="LINES ADDED"
                               FontSize="11"
                               TextColor="#94A3B8"
                               CharacterSpacing="0.5" />
                        <Label Grid.Row="1"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#34D399"
                               Margin="0,8,0,0">
                            <Label.Text>
                                <Binding Path="TotalAdditions" StringFormat="+{0:N0}" />
                            </Label.Text>
                        </Label>
                        <Label Grid.Row="2"
                               Text="lines of code"
                               FontSize="12"
                               TextColor="#94A3B8"
                               Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <!-- Lines Deleted Card -->
                <Border Grid.Column="2"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        StrokeThickness="0">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0"
                               Text="LINES DELETED"
                               FontSize="11"
                               TextColor="#94A3B8"
                               CharacterSpacing="0.5" />
                        <Label Grid.Row="1"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#F87171"
                               Margin="0,8,0,0">
                            <Label.Text>
                                <Binding Path="TotalDeletions" StringFormat="-{0:N0}" />
                            </Label.Text>
                        </Label>
                        <Label Grid.Row="2"
                               Text="lines removed"
                               FontSize="12"
                               TextColor="#94A3B8"
                               Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <!-- Net Change Card -->
                <Border Grid.Column="3"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        StrokeThickness="0">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0"
                               Text="NET CHANGE"
                               FontSize="11"
                               TextColor="#94A3B8"
                               CharacterSpacing="0.5" />
                        <Label Grid.Row="1"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#A78BFA"
                               Margin="0,8,0,0">
                            <Label.Text>
                                <Binding Path="NetChange" StringFormat="+{0:N0}" />
                            </Label.Text>
                        </Label>
                        <Label Grid.Row="2"
                               Text="net lines"
                               FontSize="12"
                               TextColor="#94A3B8"
                               Margin="0,4,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Time Period Selector -->
            <Border Grid.Row="2"
                    BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1F2937}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    StrokeThickness="1"
                    Padding="6"
                    HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="4">
                    <Button Text="Yesterday"
                            Command="{Binding SelectYesterdayCommand}"
                            FontSize="13"
                            Padding="20,10"
                            CornerRadius="8"
                            TextColor="White">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="0">
                                <Setter Property="BackgroundColor" Value="#3B82F6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="1">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="2">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="Today"
                            Command="{Binding SelectTodayCommand}"
                            FontSize="13"
                            Padding="20,10"
                            CornerRadius="8"
                            TextColor="White">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="1">
                                <Setter Property="BackgroundColor" Value="#3B82F6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="0">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="2">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="Week"
                            Command="{Binding SelectWeekCommand}"
                            FontSize="13"
                            Padding="20,10"
                            CornerRadius="8"
                            TextColor="White">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="2">
                                <Setter Property="BackgroundColor" Value="#3B82F6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="0">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriodIndex}" Value="1">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                </HorizontalStackLayout>
            </Border>

            <!-- Row 3: Group Selector Chips -->
            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding GroupsWithAll}"
                            SelectedItem="{Binding SelectedGroup}"
                            SelectionMode="Single"
                            ItemsLayout="HorizontalList"
                            HorizontalOptions="Center"
                            HeightRequest="44">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:RepositoryGroup">
                        <Border Padding="16,8"
                                Margin="4,0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="Transparent"
                                Stroke="#374151">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="Stroke" Value="#374151" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                                            <Setter Property="Stroke" Value="#3B82F6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Name}"
                                   FontSize="13"
                                   TextColor="#9CA3AF"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Row 4: Daily Trend Line Chart -->
            <Border Grid.Row="4"
                    BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 12"
                    Padding="20"
                    StrokeThickness="0"
                    HeightRequest="280"
                    IsVisible="{Binding HasData}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Label Grid.Row="0"
                           Text="📈 Daily Activity Trend"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#E2E8F0"
                           Margin="0,0,0,12" />

                    <telerik:RadCartesianChart x:Name="DailyTrendChart" Grid.Row="1">
                        <telerik:RadCartesianChart.HorizontalAxis>
                            <telerik:DateTimeContinuousAxis LabelFitMode="Rotate"
                                                            MajorStepUnit="Day"
                                                            MajorStep="1"
                                                            LabelFormat="MMM dd" />
                        </telerik:RadCartesianChart.HorizontalAxis>

                        <telerik:RadCartesianChart.VerticalAxis>
                            <telerik:NumericalAxis />
                        </telerik:RadCartesianChart.VerticalAxis>

                        <!-- Series are added dynamically in code-behind based on ProjectDailyActivities -->

                        <telerik:RadCartesianChart.ChartBehaviors>
                            <telerik:ChartTooltipBehavior TriggerMode="Tap" />
                        </telerik:RadCartesianChart.ChartBehaviors>
                    </telerik:RadCartesianChart>

                    <!-- Dynamic Legend -->
                    <FlexLayout x:Name="TrendChartLegend"
                                Grid.Row="2"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                Margin="0,8,0,0" />
                </Grid>
            </Border>

            <!-- Row 5: Activity by Project + Donut Chart -->
            <Grid Grid.Row="5" ColumnDefinitions="2*,*" ColumnSpacing="16" IsVisible="{Binding HasData}">
                <!-- Activity by Project (Horizontal Bars) -->
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        StrokeThickness="0">
                    <Grid RowDefinitions="Auto,*">
                        <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                            <Label Text="📁" FontSize="14" VerticalOptions="Center" />
                            <Label Text="Activity by Project"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#E2E8F0"
                                   VerticalOptions="Center" />
                            <Label Text="(lines changed)"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding ClientCodeMetrics}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ClientCodeMetrics">
                                    <Grid ColumnDefinitions="60,*,100" Margin="0,6">
                                        <Label Grid.Column="0"
                                               Text="{Binding ClientCode}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#F59E0B"
                                               VerticalOptions="Center" />

                                        <!-- Stacked Bar with percentage-based sizing -->
                                        <AbsoluteLayout Grid.Column="1" HeightRequest="20">
                                            <!-- Background track -->
                                            <Border BackgroundColor="#0F172A"
                                                    StrokeShape="RoundRectangle 4"
                                                    StrokeThickness="0"
                                                    AbsoluteLayout.LayoutBounds="0,0,1,1"
                                                    AbsoluteLayout.LayoutFlags="All" />
                                            <!-- Additions (green) - positioned from left -->
                                            <Border BackgroundColor="#10B981"
                                                    StrokeShape="RoundRectangle 4,0,0,4"
                                                    StrokeThickness="0"
                                                    AbsoluteLayout.LayoutFlags="All">
                                                <AbsoluteLayout.LayoutBounds>
                                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}" ConverterParameter="additions">
                                                        <Binding Path="AdditionsPercent" />
                                                        <Binding Path="DeletionsPercent" />
                                                    </MultiBinding>
                                                </AbsoluteLayout.LayoutBounds>
                                            </Border>
                                            <!-- Deletions (red) - positioned after additions -->
                                            <Border BackgroundColor="#EF4444"
                                                    StrokeShape="RoundRectangle 0,4,4,0"
                                                    StrokeThickness="0"
                                                    AbsoluteLayout.LayoutFlags="All">
                                                <AbsoluteLayout.LayoutBounds>
                                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}" ConverterParameter="deletions">
                                                        <Binding Path="AdditionsPercent" />
                                                        <Binding Path="DeletionsPercent" />
                                                    </MultiBinding>
                                                </AbsoluteLayout.LayoutBounds>
                                            </Border>
                                        </AbsoluteLayout>

                                        <Label Grid.Column="2"
                                               FontSize="11"
                                               TextColor="#94A3B8"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center">
                                            <Label.Text>
                                                <MultiBinding StringFormat="+{0:N0} / -{1:N0}">
                                                    <Binding Path="Additions" />
                                                    <Binding Path="Deletions" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <!-- Commit Distribution Donut -->
                <Border Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        StrokeThickness="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Label Grid.Row="0"
                               Text="📊 Commit Distribution"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#E2E8F0"
                               Margin="0,0,0,12" />

                        <telerik:RadPieChart Grid.Row="1">
                            <telerik:RadPieChart.ChartBehaviors>
                                <telerik:ChartSelectionBehavior DataPointSelectionMode="Single" SeriesSelectionMode="None" />
                            </telerik:RadPieChart.ChartBehaviors>
                            <telerik:RadPieChart.Series>
                                <telerik:DonutSeries ValueBinding="CommitCount"
                                                     ItemsSource="{Binding ClientCodeMetrics}"
                                                     ShowLabels="True"
                                                     LegendTitleBinding="ClientCode"
                                                     InnerRadiusFactor="0.6" />
                            </telerik:RadPieChart.Series>
                        </telerik:RadPieChart>

                        <!-- Center Label -->
                        <VerticalStackLayout Grid.Row="1"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="{Binding TotalCommits}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#E2E8F0"
                                   HorizontalOptions="Center" />
                            <Label Text="commits"
                                   FontSize="11"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Legend -->
                        <FlexLayout Grid.Row="2"
                                    Wrap="Wrap"
                                    JustifyContent="Center"
                                    Margin="0,8,0,0"
                                    BindableLayout.ItemsSource="{Binding ClientCodeMetrics}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ClientCodeMetrics">
                                    <HorizontalStackLayout Spacing="4" Margin="4,2">
                                        <Border BackgroundColor="{Binding Color}"
                                                StrokeShape="RoundRectangle 4"
                                                WidthRequest="8"
                                                HeightRequest="8"
                                                StrokeThickness="0"
                                                VerticalOptions="Center" />
                                        <Label FontSize="11" TextColor="#94A3B8" VerticalOptions="Center">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="ClientCode" />
                                                    <Binding Path="CommitCount" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 6: Recent Activity Timeline -->
            <Border Grid.Row="6"
                    BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 12"
                    Padding="20"
                    StrokeThickness="0"
                    IsVisible="{Binding HasData}">
                <Grid RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                           Text="🕐 Recent Activity"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#E2E8F0"
                           Margin="0,0,0,16" />

                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding RecentCommits}"
                                    SelectionMode="None"
                                    HeightRequest="250">
                        <CollectionView.EmptyView>
                            <Label Text="No recent commits"
                                   FontSize="13"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:CommitInfo">
                                <Grid ColumnDefinitions="24,*" Margin="0,0,0,12">
                                    <!-- Timeline dot -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="#3B82F6"
                                            StrokeShape="RoundRectangle 6"
                                            WidthRequest="12"
                                            HeightRequest="12"
                                            StrokeThickness="0"
                                            VerticalOptions="Start"
                                            Margin="0,4,0,0" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding CommittedAt, StringFormat='{0:MMM dd, h:mm tt}'}"
                                               FontSize="11"
                                               TextColor="#64748B" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Repository}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#F59E0B" />
                                            <Label Text="-"
                                                   FontSize="13"
                                                   TextColor="#64748B" />
                                            <Label Text="{Binding Message}"
                                                   FontSize="13"
                                                   TextColor="#E2E8F0"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!-- Row 7: Group Health Warnings -->
            <Border Grid.Row="7"
                    BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 12"
                    Padding="20"
                    StrokeThickness="0"
                    IsVisible="{Binding HasAnyWarnings}">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header with warning count -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                            <Label Text="Group Health"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#E2E8F0"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#DC2626"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,2"
                                StrokeThickness="0"
                                IsVisible="{Binding HasCriticalWarnings}">
                            <Label Text="{Binding TotalWarningCount, StringFormat='{0} issues'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <!-- Warnings List -->
                    <VerticalStackLayout Grid.Row="1" Spacing="8">
                        <!-- Critical Warnings -->
                        <CollectionView ItemsSource="{Binding CriticalWarnings}"
                                        SelectionMode="None"
                                        IsVisible="{Binding HasCriticalWarnings}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupWarning">
                                    <Border BackgroundColor="#0F172A"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Border.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#EF4444" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="0.1" />
                                            </LinearGradientBrush>
                                        </Border.Stroke>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,12,0" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontSize="13" FontAttributes="Bold" TextColor="#E2E8F0">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} - {1}">
                                                            <Binding Path="ClientCode" />
                                                            <Binding Path="Message" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                                <Label Text="{Binding Details}"
                                                       FontSize="11"
                                                       TextColor="#64748B" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding ActionText}"
                                                   FontSize="12"
                                                   TextColor="#60A5FA"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding ActionText, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Configuration Warnings -->
                        <CollectionView ItemsSource="{Binding Warnings}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupWarning">
                                    <Border BackgroundColor="#0F172A"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Border.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F59E0B" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="0.1" />
                                            </LinearGradientBrush>
                                        </Border.Stroke>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,12,0" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontSize="13" FontAttributes="Bold" TextColor="#E2E8F0">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} - {1}">
                                                            <Binding Path="ClientCode" />
                                                            <Binding Path="Message" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                                <Label Text="{Binding Details}"
                                                       FontSize="11"
                                                       TextColor="#64748B" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding ActionText}"
                                                   FontSize="12"
                                                   TextColor="#60A5FA"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding ActionText, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Info Warnings -->
                        <CollectionView ItemsSource="{Binding InfoWarnings}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupWarning">
                                    <Border BackgroundColor="#0F172A"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Border.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#3B82F6" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="0.1" />
                                            </LinearGradientBrush>
                                        </Border.Stroke>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,12,0" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontSize="13" FontAttributes="Bold" TextColor="#E2E8F0">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} - {1}">
                                                            <Binding Path="ClientCode" />
                                                            <Binding Path="Message" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                                <Label Text="{Binding Details}"
                                                       FontSize="11"
                                                       TextColor="#64748B" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- No Data State -->
            <Border Grid.Row="4"
                    Grid.RowSpan="4"
                    BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 12"
                    Padding="40"
                    StrokeThickness="0"
                    IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                    <Border BackgroundColor="#374151"
                            StrokeShape="RoundRectangle 50"
                            WidthRequest="100"
                            HeightRequest="100"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Label Text="📊" FontSize="48" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="No activity data"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#E2E8F0"
                           HorizontalOptions="Center" />
                    <Label Text="Select a group with repositories to see your code activity"
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentView>

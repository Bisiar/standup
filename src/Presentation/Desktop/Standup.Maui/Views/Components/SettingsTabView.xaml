<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             xmlns:models="clr-namespace:Standup.Application.Models;assembly=Standup.Application"
             x:Class="Standup.Maui.Views.Components.SettingsTabView"
             x:DataType="viewModels:SettingsViewModel">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Margin="0,0,0,20">
            <Label Text="Settings" FontSize="28" FontAttributes="Bold" />
            <Label Text="Configure your StandBot experience" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Navigation Tabs -->
        <Border Grid.Row="1" Padding="6" StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#242424}"
                Stroke="Transparent" Margin="0,0,0,20">
            <HorizontalStackLayout Spacing="8">
                <!-- AI Config Tab -->
                <Border Padding="10,8" StrokeShape="RoundRectangle 8" Stroke="Transparent"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedSettingsTab}" Value="0">
                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSettingsTabCommand}" CommandParameter="{x:Int32 0}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="AI Config" FontSize="13" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedSettingsTab}" Value="0">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- Integrations Tab -->
                <Border Padding="10,8" StrokeShape="RoundRectangle 8" Stroke="Transparent"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedSettingsTab}" Value="1">
                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSettingsTabCommand}" CommandParameter="{x:Int32 1}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Integrations" FontSize="13" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedSettingsTab}" Value="1">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- Cache Tab -->
                <Border Padding="10,8" StrokeShape="RoundRectangle 8" Stroke="Transparent"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedSettingsTab}" Value="2">
                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSettingsTabCommand}" CommandParameter="{x:Int32 2}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Cache" FontSize="13" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedSettingsTab}" Value="2">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- Appearance Tab -->
                <Border Padding="10,8" StrokeShape="RoundRectangle 8" Stroke="Transparent"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedSettingsTab}" Value="3">
                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSettingsTabCommand}" CommandParameter="{x:Int32 3}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Appearance" FontSize="13" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedSettingsTab}" Value="3">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- About Tab -->
                <Border Padding="10,8" StrokeShape="RoundRectangle 8" Stroke="Transparent"
                        BackgroundColor="Transparent">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedSettingsTab}" Value="4">
                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSettingsTabCommand}" CommandParameter="{x:Int32 4}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="About" FontSize="13" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedSettingsTab}" Value="4">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </Border>

        <!-- Content Sections -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="900">

                <!-- AI Configuration Section (Tab 0) -->
                <Border Padding="24" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                        IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=0}">
                    <VerticalStackLayout Spacing="20">
                        <!-- Section Header with Gradient Icon -->
                        <HorizontalStackLayout Spacing="16">
                            <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0" />
                                        <GradientStop Color="#A855F7" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="AI" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout>
                                <Label Text="AI Summary Configuration" FontSize="20" FontAttributes="Bold" />
                                <Label Text="Configure Azure OpenAI / AI Foundry for generating intelligent standup summaries"
                                       FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Form Grid -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <!-- Endpoint URL (spans both columns) -->
                            <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="8">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="Azure OpenAI Endpoint" FontSize="13" TextColor="Gray" />
                                    <Label Text="*" TextColor="#EF4444" />
                                </HorizontalStackLayout>
                                <Entry Text="{Binding AiEndpoint}" Placeholder="https://your-resource.openai.azure.com/" />
                                <Label Text="Your Azure OpenAI or AI Foundry endpoint URL" FontSize="11" TextColor="DimGray" />
                            </VerticalStackLayout>

                            <!-- Deployment Name -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="Deployment Name" FontSize="13" TextColor="Gray" />
                                    <Label Text="*" TextColor="#EF4444" />
                                </HorizontalStackLayout>
                                <Entry Text="{Binding AiDeploymentName}" Placeholder="gpt-4o" />
                                <Label Text="The model deployment name in your Azure resource" FontSize="11" TextColor="DimGray" />
                            </VerticalStackLayout>

                            <!-- API Key -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8">
                                <Label Text="API Key" FontSize="13" TextColor="Gray" />
                                <Entry Text="{Binding AiApiKey}" Placeholder="Leave empty to use Azure Identity" IsPassword="True" />
                                <Label Text="Optional - leave empty to use your Azure login" FontSize="11" TextColor="DimGray" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Auth Method Indicator -->
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Authentication:" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                            <Label Text="{Binding AuthMethodDisplay}" FontSize="12"
                                   TextColor="{Binding AuthMethodColor}" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Connection Status -->
                        <Border Padding="14,12" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                                IsVisible="{Binding AiValidationResult, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding AiValidationSuccess}" Value="True">
                                    <Setter Property="Stroke" Value="#22C55E" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding AiValidationSuccess}" Value="False">
                                    <Setter Property="Stroke" Value="#EF4444" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="✓" FontSize="20" TextColor="#22C55E" VerticalOptions="Center"
                                       IsVisible="{Binding AiValidationSuccess}" />
                                <Label Text="✗" FontSize="20" TextColor="#EF4444" VerticalOptions="Center"
                                       IsVisible="{Binding AiValidationSuccess, Converter={StaticResource InvertedBoolConverter}}" />
                                <VerticalStackLayout>
                                    <Label Text="{Binding AiValidationResult}" FontSize="14" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Action Buttons -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" Margin="0,4,0,0" />
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Validate Connection" Command="{Binding ValidateAIConnectionCommand}"
                                    BackgroundColor="#8B5CF6" TextColor="White" Padding="20,12"
                                    IsEnabled="{Binding IsValidatingAI, Converter={StaticResource InvertedBoolConverter}}" />
                            <Button Text="Save AI Settings" Command="{Binding SaveAISettingsCommand}"
                                    BackgroundColor="#10B981" TextColor="White" Padding="20,12" />
                            <ActivityIndicator IsRunning="{Binding IsValidatingAI}" IsVisible="{Binding IsValidatingAI}"
                                              HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Integrations Section (Tab 1) -->
                <Border Padding="24" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                        IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=1}">
                    <VerticalStackLayout Spacing="20">
                        <!-- Section Header -->
                        <HorizontalStackLayout Spacing="16">
                            <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#FBBF24" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="+" FontSize="24" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout>
                                <Label Text="Integrations" FontSize="20" FontAttributes="Bold" />
                                <Label Text="Connect external services to enhance your standup reports"
                                       FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Integration Cards Grid (2x2) -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <!-- Azure DevOps Card -->
                            <Border Grid.Row="0" Grid.Column="0" Padding="20" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1A1A1A}"
                                    Stroke="{Binding IsAzureDevOpsConnected, Converter={StaticResource BoolToColorConverter}}" StrokeThickness="1">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout>
                                        <Label Text="ADO" FontSize="24" TextColor="#0078D4" />
                                        <Border Padding="4,2" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                                BackgroundColor="{Binding IsAzureDevOpsConnected, Converter={StaticResource BoolToFilterBackgroundConverter}}"
                                                HorizontalOptions="EndAndExpand">
                                            <Label Text="{Binding AzureDevOpsConnectionStatus}" FontSize="11"
                                                   TextColor="{Binding IsAzureDevOpsConnected, Converter={StaticResource BoolToFilterTextConverter}}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Azure DevOps" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Pull commits, PRs, and work items from Azure DevOps repositories"
                                           FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />
                                    <Button Text="Configure in Projects" BackgroundColor="#3B82F6" TextColor="White"
                                            Padding="10,8" IsVisible="{Binding IsAzureDevOpsConnected, Converter={StaticResource InvertedBoolConverter}}" />
                                    <Label Text="Configured via project settings" FontSize="11" TextColor="Gray"
                                           IsVisible="{Binding IsAzureDevOpsConnected}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- GitHub Card -->
                            <Border Grid.Row="0" Grid.Column="1" Padding="20" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1A1A1A}"
                                    Stroke="{Binding IsGitHubConnected, Converter={StaticResource BoolToColorConverter}}" StrokeThickness="1">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout>
                                        <Label Text="GH" FontSize="24" TextColor="#6E5494" />
                                        <Border Padding="4,2" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                                BackgroundColor="{Binding IsGitHubConnected, Converter={StaticResource BoolToFilterBackgroundConverter}}"
                                                HorizontalOptions="EndAndExpand">
                                            <Label Text="{Binding GitHubConnectionStatus}" FontSize="11"
                                                   TextColor="{Binding IsGitHubConnected, Converter={StaticResource BoolToFilterTextConverter}}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="GitHub" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Pull commits and PRs from GitHub repositories"
                                           FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />
                                    <Button Text="Configure in Projects" BackgroundColor="#3B82F6" TextColor="White"
                                            Padding="10,8" IsVisible="{Binding IsGitHubConnected, Converter={StaticResource InvertedBoolConverter}}" />
                                    <Label Text="Configured via project settings" FontSize="11" TextColor="Gray"
                                           IsVisible="{Binding IsGitHubConnected}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Office 365 Email Card -->
                            <Border Grid.Row="1" Grid.Column="0" Padding="20" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1A1A1A}"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout>
                                        <Label Text="Email" FontSize="20" TextColor="#D83B01" />
                                        <Border Padding="4,2" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                                BackgroundColor="#1E3A5F" HorizontalOptions="EndAndExpand">
                                            <Label Text="Available" FontSize="11" TextColor="#60A5FA" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Office 365 Email" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Include client email summaries and AI-generated action items"
                                           FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />
                                    <Button Text="Configure" BackgroundColor="#3B82F6" TextColor="White" Padding="10,8" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Office 365 Calendar Card -->
                            <Border Grid.Row="1" Grid.Column="1" Padding="20" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1A1A1A}"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout>
                                        <Label Text="Cal" FontSize="20" TextColor="#0078D4" />
                                        <Border Padding="4,2" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                                BackgroundColor="#1E3A5F" HorizontalOptions="EndAndExpand">
                                            <Label Text="Available" FontSize="11" TextColor="#60A5FA" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Office 365 Calendar" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Add meeting summaries and schedule context to your standups"
                                           FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />
                                    <Button Text="Configure" BackgroundColor="#3B82F6" TextColor="White" Padding="10,8" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Microsoft Teams Card -->
                            <Border Grid.Row="2" Grid.Column="0" Padding="20" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1A1A1A}"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout>
                                        <Label Text="Teams" FontSize="18" TextColor="#6264A7" />
                                        <Border Padding="4,2" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" HorizontalOptions="EndAndExpand">
                                            <Label Text="Coming Soon" FontSize="11" TextColor="Gray" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Microsoft Teams" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Post standup reports directly to Teams channels"
                                           FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />
                                    <Button Text="Coming Soon" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                            TextColor="Gray" Padding="10,8" IsEnabled="False" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Dynamics 365 CRM Card - Multi-Tenant -->
                            <Border Grid.Row="2" Grid.Column="1" Padding="20" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1A1A1A}"
                                    Stroke="{Binding IsCrmConnected, Converter={StaticResource BoolToColorConverter}}" StrokeThickness="1">
                                <VerticalStackLayout Spacing="12">
                                    <HorizontalStackLayout>
                                        <Label Text="CRM" FontSize="20" TextColor="#002050" />
                                        <Border Padding="4,2" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                                BackgroundColor="{Binding IsCrmConnected, Converter={StaticResource BoolToFilterBackgroundConverter}}"
                                                HorizontalOptions="EndAndExpand">
                                            <Label Text="{Binding CrmConnectionStatus}" FontSize="11"
                                                   TextColor="{Binding IsCrmConnected, Converter={StaticResource BoolToFilterTextConverter}}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Dynamics 365 CRM" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Configure CRM tenants for project timelines and client context"
                                           FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />

                                    <!-- Tenant List -->
                                    <CollectionView ItemsSource="{Binding CrmTenants}" SelectionMode="None"
                                                    HeightRequest="120" IsVisible="{Binding HasCrmTenants}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:CrmTenantConfig">
                                                <Border Padding="10" Margin="0,4" StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#2A2A2A}"
                                                        Stroke="Transparent">
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                            <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" />
                                                            <Label Text="{Binding InstanceUrl}" FontSize="11" TextColor="Gray"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding AuthMethodDisplay}" FontSize="10" TextColor="#3B82F6" />
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="1" Text="Edit" FontSize="11" Padding="8,4"
                                                                BackgroundColor="Transparent" TextColor="#3B82F6"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=StartEditCrmTenantCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        <Button Grid.Column="2" Text="Delete" FontSize="11" Padding="8,4"
                                                                BackgroundColor="Transparent" TextColor="#EF4444"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=DeleteCrmTenantCommand}"
                                                                CommandParameter="{Binding .}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                        <CollectionView.EmptyView>
                                            <Label Text="No CRM tenants configured" FontSize="12" TextColor="Gray"
                                                   HorizontalOptions="Center" Padding="20" />
                                        </CollectionView.EmptyView>
                                    </CollectionView>

                                    <!-- Add Tenant Button -->
                                    <Button Text="+ Add CRM Tenant" BackgroundColor="#3B82F6" TextColor="White"
                                            Padding="10,8" Command="{Binding StartAddCrmTenantCommand}"
                                            IsVisible="{Binding IsEditingCrmTenant, Converter={StaticResource InvertedBoolConverter}}" />

                                    <!-- Edit Form (shown when editing) -->
                                    <Border Padding="16" StrokeShape="RoundRectangle 8" Stroke="#3B82F6"
                                            BackgroundColor="{AppThemeBinding Light=#F0F8FF, Dark=#1A2A3A}"
                                            IsVisible="{Binding IsEditingCrmTenant}">
                                        <VerticalStackLayout Spacing="12">
                                            <Label FontSize="14" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EditingCrmTenant, Converter={StaticResource IsNullConverter}}" Value="True">
                                                        <Setter Property="Text" Value="Add CRM Tenant" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EditingCrmTenant, Converter={StaticResource IsNullConverter}}" Value="False">
                                                        <Setter Property="Text" Value="Edit CRM Tenant" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="Name *" FontSize="11" TextColor="Gray" />
                                                <Entry Text="{Binding EditCrmTenantName}" Placeholder="e.g., JourneyTeam CRM" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="Instance URL *" FontSize="11" TextColor="Gray" />
                                                <Entry Text="{Binding EditCrmTenantInstanceUrl}"
                                                       Placeholder="https://org.crm.dynamics.com" Keyboard="Url" />
                                            </VerticalStackLayout>

                                            <Label Text="Optional: Client Credentials (leave blank for Azure Identity)"
                                                   FontSize="11" TextColor="Gray" FontAttributes="Italic" />

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                    <Label Text="Tenant ID" FontSize="11" TextColor="Gray" />
                                                    <Entry Text="{Binding EditCrmTenantTenantId}" Placeholder="(optional)" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                    <Label Text="Client ID" FontSize="11" TextColor="Gray" />
                                                    <Entry Text="{Binding EditCrmTenantClientId}" Placeholder="(optional)" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="Client Secret" FontSize="11" TextColor="Gray" />
                                                <Entry Text="{Binding EditCrmTenantClientSecret}" Placeholder="(optional)" IsPassword="True" />
                                            </VerticalStackLayout>

                                            <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                                                <Button Text="Cancel" BackgroundColor="Transparent" TextColor="Gray"
                                                        Padding="12,8" Command="{Binding CancelEditCrmTenantCommand}" />
                                                <Button Text="Save" BackgroundColor="#22C55E" TextColor="White"
                                                        Padding="12,8" Command="{Binding SaveCrmTenantCommand}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Cache Management Section (Tab 2) -->
                <Border Padding="24" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                        IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=2}">
                    <VerticalStackLayout Spacing="20">
                        <!-- Section Header -->
                        <HorizontalStackLayout Spacing="16">
                            <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0" />
                                        <GradientStop Color="#60A5FA" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="DB" FontSize="18" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout>
                                <Label Text="Cache Management" FontSize="20" FontAttributes="Bold" />
                                <Label Text="Manage cached data and standup reports"
                                       FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Stats Row -->
                        <HorizontalStackLayout Spacing="20">
                            <!-- Cached Reports -->
                            <Border Padding="20" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                                    HorizontalOptions="FillAndExpand">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding CacheEntryCount}" FontSize="32" FontAttributes="Bold"
                                           TextColor="#60A5FA" HorizontalOptions="Center" />
                                    <Label Text="Cached Reports" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Cache Size -->
                            <Border Padding="20" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                                    HorizontalOptions="FillAndExpand">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding CacheSizeDisplay}" FontSize="32" FontAttributes="Bold"
                                           TextColor="#60A5FA" HorizontalOptions="Center" />
                                    <Label Text="Cache Size" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Last Cleared -->
                            <Border Padding="20" StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                                    HorizontalOptions="FillAndExpand">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label Text="{Binding LastCacheCleared}" FontSize="32" FontAttributes="Bold"
                                           TextColor="#60A5FA" HorizontalOptions="Center" />
                                    <Label Text="Last Cleared" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Action Buttons -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" Margin="0,4,0,0" />
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Clear All Cache" Command="{Binding ClearCacheCommand}"
                                    BackgroundColor="#EF4444" TextColor="White" Padding="20,12" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Appearance Section (Tab 3) -->
                <Border Padding="24" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                        IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=3}">
                    <VerticalStackLayout Spacing="20">
                        <!-- Section Header -->
                        <HorizontalStackLayout Spacing="16">
                            <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EC4899" Offset="0" />
                                        <GradientStop Color="#F472B6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="FX" FontSize="18" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout>
                                <Label Text="Appearance" FontSize="20" FontAttributes="Bold" />
                                <Label Text="Customize the look and feel of StandBot"
                                       FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Theme Label -->
                        <Label Text="Theme" FontSize="13" TextColor="Gray" />

                        <!-- Theme Options -->
                        <HorizontalStackLayout Spacing="16">
                            <!-- Light Theme -->
                            <Border Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="2"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                                    WidthRequest="150">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTheme}" Value="Light">
                                        <Setter Property="Stroke" Value="#3B82F6" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLightThemeCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Border WidthRequest="100" HeightRequest="60" StrokeShape="RoundRectangle 8" Stroke="Transparent">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F8FAFC" Offset="0" />
                                                <GradientStop Color="#E2E8F0" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Label Text="Light" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Dark Theme -->
                            <Border Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="2"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                                    WidthRequest="150">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTheme}" Value="Dark">
                                        <Setter Property="Stroke" Value="#3B82F6" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDarkThemeCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Border WidthRequest="100" HeightRequest="60" StrokeShape="RoundRectangle 8" Stroke="Transparent">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#1E293B" Offset="0" />
                                                <GradientStop Color="#0F172A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Label Text="Dark" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- System Theme -->
                            <Border Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="2"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                                    WidthRequest="150">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedTheme}" Value="System">
                                        <Setter Property="Stroke" Value="#3B82F6" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSystemThemeCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Grid WidthRequest="100" HeightRequest="60">
                                        <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" WidthRequest="50" HorizontalOptions="Start">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#F8FAFC" Offset="0" />
                                                    <GradientStop Color="#E2E8F0" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" WidthRequest="50" HorizontalOptions="End">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#1E293B" Offset="0" />
                                                    <GradientStop Color="#0F172A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <Label Text="System" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- About Section (Tab 4) -->
                <Border Padding="24" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                        IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=4}">
                    <VerticalStackLayout Spacing="20">
                        <!-- Section Header -->
                        <HorizontalStackLayout Spacing="16">
                            <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#64748B" Offset="0" />
                                        <GradientStop Color="#94A3B8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="i" FontSize="24" TextColor="White" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout>
                                <Label Text="About" FontSize="20" FontAttributes="Bold" />
                                <Label Text="Application information and resources"
                                       FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- About Content -->
                        <HorizontalStackLayout Spacing="24">
                            <!-- App Logo -->
                            <Border WidthRequest="80" HeightRequest="80" StrokeShape="RoundRectangle 20" Stroke="Transparent">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F97316" Offset="0" />
                                        <GradientStop Color="#EA580C" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="SB" FontSize="32" TextColor="White" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- App Info -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="StandBot" FontSize="22" FontAttributes="Bold" />
                                <Label Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="14" TextColor="Gray" />
                                <Label Text="Standup Automation Platform - Collects work activity from GitHub and Azure DevOps, summarizes with AI, and delivers intelligent standup reports via Teams or email. Built with .NET MAUI and Telerik UI."
                                       FontSize="14" TextColor="Gray" LineBreakMode="WordWrap" MaximumWidthRequest="500" Margin="0,8,0,0" />

                                <!-- Links -->
                                <HorizontalStackLayout Spacing="16" Margin="0,12,0,0">
                                    <Label Text="Documentation" FontSize="13" TextColor="#60A5FA" TextDecorations="Underline">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="Report Issue" FontSize="13" TextColor="#60A5FA" TextDecorations="Underline">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="Feature Request" FontSize="13" TextColor="#60A5FA" TextDecorations="Underline">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="Changelog" FontSize="13" TextColor="#60A5FA" TextDecorations="Underline">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Status Message -->
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#10B981"
                       HorizontalOptions="Center"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.RowSpan="3" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                          HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             xmlns:entities="clr-namespace:Standup.Domain.Entities;assembly=Standup.Domain"
             xmlns:dtos="clr-namespace:Standup.Application.DTOs;assembly=Standup.Application"
             x:Class="Standup.Maui.Views.Components.StandupTabView"
             x:DataType="viewModels:StandupViewModel">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR - Configuration -->
        <Grid Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#242424}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="20">
                    <!-- Header -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Standup Report" FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                        <Label Text="Generate AI-powered standup summaries" FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}" />
                    </VerticalStackLayout>

                    <!-- Group Selector -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="SELECT GROUP" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}"
                               CharacterSpacing="0.5" />
                        <Border StrokeShape="RoundRectangle 10" Padding="2"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#404040}"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1a1a1a}">
                            <Picker ItemsSource="{Binding Groups}"
                                    SelectedItem="{Binding SelectedGroup}"
                                    ItemDisplayBinding="{Binding Name}"
                                    FontSize="14"
                                    TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Period Selector -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="TIME PERIOD" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}"
                               CharacterSpacing="0.5" />
                        <Border StrokeShape="RoundRectangle 10" Padding="4"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1a1a1a}">
                            <HorizontalStackLayout Spacing="0">
                                <Button Text="Yesterday"
                                        Command="{Binding SetPeriodYesterdayCommand}"
                                        FontSize="12" Padding="12,10" CornerRadius="8" BorderWidth="0">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="0">
                                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="1">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94a3b8}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="2">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94a3b8}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Today"
                                        Command="{Binding SetPeriodTodayCommand}"
                                        FontSize="12" Padding="12,10" CornerRadius="8" BorderWidth="0">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="1">
                                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="0">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94a3b8}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="2">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94a3b8}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Week"
                                        Command="{Binding SetPeriodWeekCommand}"
                                        FontSize="12" Padding="12,10" CornerRadius="8" BorderWidth="0">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="2">
                                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="0">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94a3b8}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedPeriod}" Value="1">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94a3b8}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Section Toggles -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="INCLUDE SECTIONS" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}"
                               CharacterSpacing="0.5" />

                        <!-- Executive Summary Toggle -->
                        <Border StrokeShape="RoundRectangle 12" Padding="14"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#333}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="Executive Summary" FontSize="14" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                    <Label Text="Business-focused overview" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding GenerateExecutive}"
                                        OnColor="#3B82F6" ThumbColor="White" />
                            </Grid>
                        </Border>

                        <!-- Technical Summary Toggle -->
                        <Border StrokeShape="RoundRectangle 12" Padding="14"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#333}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="Technical Summary" FontSize="14" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                    <Label Text="Developer-focused details" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding GenerateTechnical}"
                                        OnColor="#10B981" ThumbColor="White" />
                            </Grid>
                        </Border>

                        <!-- Code Review Toggle -->
                        <Border StrokeShape="RoundRectangle 12" Padding="14"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#333}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="Code Review" FontSize="14" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                    <Label Text="Security and quality analysis" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding GenerateCodeReview}"
                                        OnColor="#8B5CF6" ThumbColor="White" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Generate Button -->
                    <Button Text="Generate Standup"
                            Command="{Binding GenerateStandupCommand}"
                            FontSize="15" FontAttributes="Bold" Padding="16" CornerRadius="12"
                            TextColor="White"
                            IsVisible="{Binding IsGenerating, Converter={StaticResource InvertedBoolConverter}}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#f97316" Offset="0" />
                                <GradientStop Color="#ea580c" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Progress During Generation -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsGenerating}">
                        <Border StrokeShape="RoundRectangle 12" Padding="16"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}">
                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <ActivityIndicator IsRunning="True" WidthRequest="20" HeightRequest="20"
                                                       Color="#f97316" />
                                    <Label Text="{Binding GenerationProgress, StringFormat='{0:P0}'}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                </HorizontalStackLayout>
                                <ProgressBar Progress="{Binding GenerationProgress}" ProgressColor="#f97316"
                                             HeightRequest="6" />
                                <Label Text="{Binding StatusMessage}" FontSize="11"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}"
                                       HorizontalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- History Section -->
                    <VerticalStackLayout Spacing="10"
                                        IsVisible="{Binding ReportHistory.Count, Converter={StaticResource IntToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="RECENT REPORTS" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}"
                                   CharacterSpacing="0.5" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Clear" FontSize="10"
                                    BackgroundColor="#EF4444" TextColor="White"
                                    Padding="8,4" HeightRequest="24" CornerRadius="6"
                                    Command="{Binding ClearAllHistoryCommand}" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding ReportHistory}" HeightRequest="160" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="entities:ReportHistory">
                                    <Border Margin="0,2" Padding="10,8" StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#333}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:StandupViewModel}}, Path=LoadHistoryItemCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding GroupName}" FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                                <Label Text="{Binding GeneratedAt, StringFormat='{0:MMM dd, HH:mm}'}"
                                                       FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding TotalCommits, StringFormat='{0} commits'}"
                                                   FontSize="10" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748b}"
                                                   VerticalOptions="Center" Margin="0,0,8,0" />
                                            <Button Grid.Column="2" Text="x" FontSize="12"
                                                    BackgroundColor="Transparent" TextColor="#EF4444"
                                                    WidthRequest="24" HeightRequest="24" Padding="0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:StandupViewModel}}, Path=DeleteHistoryItemCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Splitter Bar -->
        <BoxView Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#404040}" />

        <!-- RIGHT PANEL - Report Content -->
        <Grid Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}">
            <!-- Empty State -->
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                IsVisible="{Binding HasReport, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="📝" FontSize="64" HorizontalOptions="Center" Opacity="0.5" />
                <Label Text="No Report Generated" FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#94A3B8, Dark=#94a3b8}"
                       HorizontalOptions="Center" Margin="0,16,0,0" />
                <Label Text="Configure options and click Generate Standup" FontSize="14"
                       TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#64748b}"
                       HorizontalOptions="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <!-- Report Content -->
            <Grid IsVisible="{Binding HasReport}" RowDefinitions="Auto,*">
                <!-- Tab Bar -->
                <Border Grid.Row="0" Padding="16,12"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#242424}"
                        StrokeThickness="0,0,0,1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#404040}">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- View Tabs -->
                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                            <Border StrokeShape="RoundRectangle 8" Padding="4"
                                    BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1a1a1a}">
                                <HorizontalStackLayout Spacing="0">
                                    <Button Text="Report" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Int32 1}"
                                            FontSize="12" Padding="12,8" CornerRadius="6" BorderWidth="0">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding CurrentViewMode}" Value="1">
                                                <Setter Property="BackgroundColor" Value="#3B82F6" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Command="{Binding SwitchViewCommand}" CommandParameter="{x:Int32 2}"
                                            FontSize="12" Padding="12,8" CornerRadius="6" BorderWidth="0">
                                        <Button.Text>
                                            <Binding Path="GroupedReport.TotalCommits" StringFormat="Commits ({0})" FallbackValue="Commits" />
                                        </Button.Text>
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding CurrentViewMode}" Value="2">
                                                <Setter Property="BackgroundColor" Value="#3B82F6" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Command="{Binding SwitchViewCommand}" CommandParameter="{x:Int32 3}"
                                            FontSize="12" Padding="12,8" CornerRadius="6" BorderWidth="0">
                                        <Button.Text>
                                            <Binding Path="GroupedReport.TotalPullRequests" StringFormat="PRs ({0})" FallbackValue="PRs" />
                                        </Button.Text>
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding CurrentViewMode}" Value="3">
                                                <Setter Property="BackgroundColor" Value="#10B981" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Command="{Binding SwitchViewCommand}" CommandParameter="{x:Int32 4}"
                                            FontSize="12" Padding="12,8" CornerRadius="6" BorderWidth="0">
                                        <Button.Text>
                                            <Binding Path="GroupedReport.TotalWorkItems" StringFormat="Tasks ({0})" FallbackValue="Tasks" />
                                        </Button.Text>
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding CurrentViewMode}" Value="4">
                                                <Setter Property="BackgroundColor" Value="#8B5CF6" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Action Buttons -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <Button Text="Copy" Command="{Binding CopyToClipboardCommand}"
                                    BackgroundColor="#3B82F6" TextColor="White"
                                    FontSize="12" Padding="12,8" CornerRadius="8" />
                            <Button Text="Save" Command="{Binding SaveReportCommand}"
                                    BackgroundColor="#10B981" TextColor="White"
                                    FontSize="12" Padding="12,8" CornerRadius="8" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Content Views -->
                <Grid Grid.Row="1">
                    <!-- VIEW 1: Report Summary -->
                    <Grid IsVisible="{Binding CurrentViewMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=1}"
                          RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="20">
                        <!-- Header -->
                        <VerticalStackLayout Grid.Row="0" Spacing="4">
                            <Label Text="{Binding SelectedGroup.Name, StringFormat='Standup Report - {0}'}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                            <Label FontSize="14" TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding GroupedReport.PeriodStart, StringFormat='{0:MMM dd}'}" />
                                        <Span Text=" - " />
                                        <Span Text="{Binding GroupedReport.PeriodEnd, StringFormat='{0:MMM dd, yyyy}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Display Toggle -->
                        <HorizontalStackLayout Grid.Row="1" Spacing="10">
                            <Label Text="Markdown" VerticalOptions="Center" FontSize="13"
                                   TextColor="{Binding ShowAsHtml, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Gray|#10B981}" />
                            <Switch IsToggled="{Binding ShowAsHtml}" OnColor="#3B82F6" ThumbColor="White" />
                            <Label Text="HTML" VerticalOptions="Center" FontSize="13"
                                   TextColor="{Binding ShowAsHtml, Converter={StaticResource BoolToTextConverter}, ConverterParameter=#10B981|Gray}" />
                        </HorizontalStackLayout>

                        <!-- HTML View - fills remaining space -->
                        <Border Grid.Row="2" StrokeShape="RoundRectangle 12" Padding="0"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                                IsVisible="{Binding ShowAsHtml}">
                            <WebView>
                                <WebView.Source>
                                    <HtmlWebViewSource Html="{Binding HtmlReportContent}" />
                                </WebView.Source>
                            </WebView>
                        </Border>

                        <!-- Markdown View - scrollable -->
                        <ScrollView Grid.Row="2" IsVisible="{Binding ShowAsHtml, Converter={StaticResource InvertedBoolConverter}}">
                            <Border StrokeShape="RoundRectangle 12" Padding="16"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#2D2D2D}">
                                <Label Text="{Binding ReportContent}" FontSize="13" FontFamily="Menlo"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                            </Border>
                        </ScrollView>
                    </Grid>

                    <!-- VIEW 2: Commits -->
                    <Grid IsVisible="{Binding CurrentViewMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=2}"
                          RowDefinitions="4,*">
                        <BoxView Grid.Row="0" Color="#3B82F6" />
                        <ScrollView Grid.Row="1" Padding="24">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="{Binding GroupedReport.TotalCommits, StringFormat='Commits ({0})'}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                <CollectionView ItemsSource="{Binding GroupedReport.Sections}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:ClientCodeSection">
                                            <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#242424}"
                                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#333}">
                                                <VerticalStackLayout Spacing="12">
                                                    <Label Text="{Binding ClientCode}" FontSize="16" FontAttributes="Bold"
                                                           TextColor="#f59e0b" />
                                                    <CollectionView ItemsSource="{Binding Commits}">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="entities:CommitInfo">
                                                                <Grid Padding="8,6" ColumnDefinitions="70,*,Auto"
                                                                      BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}">
                                                                    <Label Grid.Column="0" Text="{Binding Sha, StringFormat='{0:7}'}"
                                                                           FontSize="11" FontFamily="Menlo"
                                                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#64748b}" />
                                                                    <Label Grid.Column="1" Text="{Binding Message}" FontSize="13"
                                                                           LineBreakMode="TailTruncation" MaxLines="1"
                                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                                                    <Label Grid.Column="2"
                                                                           Text="{Binding CommittedAt, Converter={StaticResource DateToRelativeConverter}}"
                                                                           FontSize="11"
                                                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748b}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </CollectionView.ItemTemplate>
                                                    </CollectionView>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- VIEW 3: PRs -->
                    <Grid IsVisible="{Binding CurrentViewMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=3}"
                          RowDefinitions="4,*">
                        <BoxView Grid.Row="0" Color="#10B981" />
                        <ScrollView Grid.Row="1" Padding="24">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="{Binding GroupedReport.TotalPullRequests, StringFormat='Pull Requests ({0})'}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                <CollectionView ItemsSource="{Binding GroupedReport.Sections}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:ClientCodeSection">
                                            <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#242424}"
                                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#333}">
                                                <VerticalStackLayout Spacing="12">
                                                    <Label Text="{Binding ClientCode}" FontSize="16" FontAttributes="Bold"
                                                           TextColor="#10B981" />
                                                    <Label Text="No pull requests in this period" FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748b}"
                                                           IsVisible="{Binding PullRequests.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=invert}" />
                                                    <CollectionView ItemsSource="{Binding PullRequests}">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="entities:PullRequestInfo">
                                                                <Grid Padding="8,6" ColumnDefinitions="Auto,*"
                                                                      BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}">
                                                                    <Border Grid.Column="0" Padding="6,2" StrokeShape="RoundRectangle 4"
                                                                            BackgroundColor="#10B981" Margin="0,0,8,0">
                                                                        <Label Text="{Binding Status}" FontSize="10" TextColor="White" />
                                                                    </Border>
                                                                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                                           LineBreakMode="TailTruncation" MaxLines="1"
                                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </CollectionView.ItemTemplate>
                                                    </CollectionView>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- VIEW 4: Work Items -->
                    <Grid IsVisible="{Binding CurrentViewMode, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=4}"
                          RowDefinitions="4,*">
                        <BoxView Grid.Row="0" Color="#8B5CF6" />
                        <ScrollView Grid.Row="1" Padding="24">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="{Binding GroupedReport.TotalWorkItems, StringFormat='Work Items ({0})'}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                <CollectionView ItemsSource="{Binding GroupedReport.Sections}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:ClientCodeSection">
                                            <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#242424}"
                                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#333}">
                                                <VerticalStackLayout Spacing="12">
                                                    <Label Text="{Binding ClientCode}" FontSize="16" FontAttributes="Bold"
                                                           TextColor="#8B5CF6" />
                                                    <Label Text="No work items in this period" FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748b}"
                                                           IsVisible="{Binding WorkItems.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=invert}" />
                                                    <CollectionView ItemsSource="{Binding WorkItems}">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="entities:WorkItemInfo">
                                                                <Grid Padding="8,6" ColumnDefinitions="Auto,*"
                                                                      BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1a1a1a}">
                                                                    <Border Grid.Column="0" Padding="6,2" StrokeShape="RoundRectangle 4"
                                                                            BackgroundColor="#8B5CF6" Margin="0,0,8,0">
                                                                        <Label Text="{Binding State}" FontSize="10" TextColor="White" />
                                                                    </Border>
                                                                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                                           LineBreakMode="TailTruncation" MaxLines="1"
                                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </CollectionView.ItemTemplate>
                                                    </CollectionView>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <ActivityIndicator Grid.ColumnSpan="3" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                          HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentView>

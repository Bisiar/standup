<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>standup-blazor-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Telerik UI -->
    <PackageReference Include="Telerik.UI.for.Blazor" />

    <!-- Azure AD Authentication -->
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Microsoft.Identity.Web.UI" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared UI Library -->
    <ProjectReference Include="..\..\Shared\Standup.UI\Standup.UI.csproj" />

    <!-- Core layers -->
    <ProjectReference Include="..\..\..\Core\Standup.Application\Standup.Application.csproj" />
    <ProjectReference Include="..\..\..\Infrastructure\Standup.Infrastructure\Standup.Infrastructure.csproj" />
  </ItemGroup>

</Project>

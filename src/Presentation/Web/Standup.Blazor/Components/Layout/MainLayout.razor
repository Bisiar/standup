@inherits LayoutComponentBase

<TelerikRootComponent>
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</TelerikRootComponent>

<style>
    .page {
        position: relative;
        display: flex;
        min-height: 100vh;
    }

    main {
        flex: 1;
        background-color: #0f172a;
        margin-left: 250px;
    }

    .sidebar {
        background-color: #1e293b;
        width: 250px;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
    }

    article.content {
        padding-top: 1rem;
        color: #e2e8f0;
    }

    @@media (max-width: 768px) {
        .sidebar {
            width: 100%;
            position: relative;
        }

        main, article.content {
            margin-left: 0;
        }
    }
</style>

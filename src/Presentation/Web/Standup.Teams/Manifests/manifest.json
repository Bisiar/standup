{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "JourneyTeam",
    "websiteUrl": "https://journeyteam.com",
    "privacyUrl": "https://journeyteam.com/privacy",
    "termsOfUseUrl": "https://journeyteam.com/terms"
  },
  "name": {
    "short": "Standup Bot",
    "full": "Standup Automation Bot"
  },
  "description": {
    "short": "Generate daily standup reports from your repos",
    "full": "Standup Bot automatically aggregates your commits, pull requests, and work items from GitHub and Azure DevOps to generate AI-powered daily standup reports. Get reminders, share to channels, and never miss a standup again."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#5558AF",
  "bots": [
    {
      "botId": "{{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupChat"],
          "commands": [
            {
              "title": "standup",
              "description": "Generate your daily standup report"
            },
            {
              "title": "subscribe",
              "description": "Subscribe to daily standup reminders"
            },
            {
              "title": "unsubscribe",
              "description": "Unsubscribe from reminders"
            },
            {
              "title": "settings",
              "description": "View and update your preferences"
            },
            {
              "title": "help",
              "description": "Show available commands"
            }
          ]
        }
      ]
    }
  ],
  "composeExtensions": [
    {
      "botId": "{{BOT_ID}}",
      "commands": [
        {
          "id": "searchStandups",
          "type": "query",
          "title": "Search Standups",
          "description": "Search previous standup reports",
          "initialRun": true,
          "parameters": [
            {
              "name": "searchQuery",
              "title": "Search",
              "description": "Search by date or content",
              "inputType": "text"
            }
          ]
        },
        {
          "id": "createStandup",
          "type": "action",
          "title": "Create Standup",
          "description": "Generate a new standup report",
          "fetchTask": true,
          "context": ["commandBox", "compose", "message"]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": [
    "standup.journeyteam.com",
    "{{BOT_DOMAIN}}"
  ],
  "webApplicationInfo": {
    "id": "{{AAD_APP_CLIENT_ID}}",
    "resource": "api://{{BOT_DOMAIN}}/{{AAD_APP_CLIENT_ID}}"
  }
}

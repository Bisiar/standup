<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-maccatalyst;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Standup.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Standup</ApplicationTitle>
    <ApplicationId>com.journeyteam.standup</ApplicationId>
    <ApplicationIdGuid>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>

    <!-- CLI tool settings for non-MAUI target -->
    <PackAsTool Condition="'$(TargetFramework)' == 'net10.0'">true</PackAsTool>
    <ToolCommandName>standup</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>Standup.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>JourneyTeam</Authors>
    <Description>Standup automation app with multi-project support</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0-preview.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Standup.Application\Standup.Application.csproj" />
    <ProjectReference Include="..\Standup.Infrastructure\Standup.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy wiki documentation to Resources/Documents at build time -->
  <Target Name="CopyWikiDocuments" BeforeTargets="Build">
    <ItemGroup>
      <WikiFiles Include="$(ProjectDir)..\..\wiki\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(ProjectDir)Resources\Documents" Condition="!Exists('$(ProjectDir)Resources\Documents')" />
    <Copy SourceFiles="@(WikiFiles)" DestinationFolder="$(ProjectDir)Resources\Documents\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Documents\**\*.*" Condition="Exists('Resources\Documents')">
      <LogicalName>Docs.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

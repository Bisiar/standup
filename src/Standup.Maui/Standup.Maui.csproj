<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform-specific targeting: Windows builds Windows, Mac builds Mac -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Standup.Maui</RootNamespace>
    <AssemblyName>StandBot</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Enable .NET 10 global XML namespace feature (preview) -->
    <DefineConstants>$(DefineConstants);MauiAllowImplicitXmlnsDeclaration</DefineConstants>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>

    <!-- Display name -->
    <ApplicationTitle>StandBot</ApplicationTitle>
    <ApplicationId>com.digitalsolutions.standbot</ApplicationId>
    <ApplicationIdGuid>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>

    <!-- Workaround for Xcode version mismatch - use Link Framework SDKs Only -->
    <MtouchLink Condition="$(TargetFramework.Contains('maccatalyst'))">SdkOnly</MtouchLink>
    <ValidateXcodeVersion Condition="$(TargetFramework.Contains('maccatalyst'))">false</ValidateXcodeVersion>

    <!-- Enable Keychain entitlements for SecureStorage on MacCatalyst -->
    <CodesignEntitlements Condition="$(TargetFramework.Contains('maccatalyst'))">Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F172A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F172A" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
    <!-- <PackageReference Include="CommunityToolkit.Maui" /> temporarily disabled to test crash -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Standup.Application\Standup.Application.csproj" />
    <ProjectReference Include="..\Standup.Infrastructure\Standup.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy wiki documentation to Resources/Documents at build time -->
  <Target Name="CopyWikiDocuments" BeforeTargets="Build">
    <ItemGroup>
      <WikiFiles Include="$(ProjectDir)..\..\wiki\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(ProjectDir)Resources\Documents" Condition="!Exists('$(ProjectDir)Resources\Documents')" />
    <Copy SourceFiles="@(WikiFiles)" DestinationFolder="$(ProjectDir)Resources\Documents\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Documents\**\*.*" Condition="Exists('Resources\Documents')">
      <LogicalName>Docs.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             x:Class="Standup.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Local converters (avoiding CommunityToolkit which causes crash on macOS 26) -->
            <global:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <global:IsNullConverter x:Key="IsNullConverter" />
            <global:IsNotNullConverter x:Key="IsNotNullConverter" />
            <global:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <global:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <global:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />
            <global:IntToBoolConverter x:Key="IntToBoolConverter" />
            <global:IntEqualsToBoolConverter x:Key="IntEqualsToBoolConverter" />
            <global:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <global:BoolToTextConverter x:Key="BoolToTextConverter" />
            <global:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

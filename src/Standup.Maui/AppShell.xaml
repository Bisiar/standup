<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Standup.Maui.Views"
       x:Class="Standup.Maui.AppShell"
       Title="Standup">

    <!-- Using TabBar instead of FlyoutBehavior="Flyout" to avoid Swift Observation crash on macOS 26 Tahoe -->
    <TabBar>
        <ShellContent Title="Projects" ContentTemplate="{DataTemplate views:ProjectListPage}" Route="ProjectListPage" />
        <ShellContent Title="Standup" ContentTemplate="{DataTemplate views:StandupPage}" Route="StandupPage" />
        <ShellContent Title="Repos" ContentTemplate="{DataTemplate views:RepositoryConfigPage}" Route="RepositoryConfigPage" />
        <ShellContent Title="Docs" ContentTemplate="{DataTemplate views:DocumentsPage}" Route="DocumentsPage" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
    </TabBar>

</Shell>

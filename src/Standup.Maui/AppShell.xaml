<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
       x:Class="Standup.Maui.AppShell"
       Title="StandBot">

    <!-- Using TabBar instead of FlyoutBehavior="Flyout" to avoid Swift Observation crash on macOS 26 Tahoe -->
    <TabBar>
        <ShellContent Title="Projects" ContentTemplate="{DataTemplate global:ProjectListPage}" Route="ProjectListPage" />
        <ShellContent Title="Standup" ContentTemplate="{DataTemplate global:StandupPage}" Route="StandupPage" />
        <ShellContent Title="Repos" ContentTemplate="{DataTemplate global:RepositoryConfigPage}" Route="RepositoryConfigPage" />
        <ShellContent Title="Docs" ContentTemplate="{DataTemplate global:DocumentsPage}" Route="DocumentsPage" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate global:SettingsPage}" Route="SettingsPage" />
    </TabBar>

</Shell>

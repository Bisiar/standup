<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             xmlns:models="clr-namespace:Standup.Application.Models;assembly=Standup.Application"
             x:Class="Standup.Maui.Views.DocumentsPage"
             x:DataType="viewModels:DocumentsViewModel"
             Title="Documentation">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Document List -->
        <Border Grid.Column="0" Padding="10"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">
            <VerticalStackLayout>
                <Label Text="Documents" FontSize="18" FontAttributes="Bold" Margin="10" />

                <CollectionView ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DocumentItem">
                            <Border Margin="5" Padding="10"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D2D}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:DocumentsViewModel}}, Path=SelectDocumentCommand}"
                                                         CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout>
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Text="{Binding Category}" FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Document Content -->
        <ScrollView Grid.Column="1" Padding="20">
            <VerticalStackLayout>
                <Label Text="{Binding SelectedDocument.Title}" FontSize="24" FontAttributes="Bold" Margin="0,0,0,15" />
                <Label Text="{Binding DocumentContent}" FontSize="14" />
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                          HorizontalOptions="Center" VerticalOptions="Center" Grid.ColumnSpan="2" Grid.Column="0" />
    </Grid>
</ContentPage>

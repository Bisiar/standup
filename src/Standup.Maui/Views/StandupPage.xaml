<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             x:Class="Standup.Maui.Views.StandupPage"
             x:DataType="viewModels:StandupViewModel"
             Title="Generate Standup">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Standup Report" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding CurrentProject.Name, StringFormat='Project: {0}'}" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Report Content -->
        <Border Grid.Row="1" Margin="0,15" Padding="15" StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
            <ScrollView>
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding LatestReport.Summary}"
                          FontSize="14"
                          IsVisible="{Binding LatestReport, Converter={StaticResource IsNotNullConverter}}" />

                    <Label Text="Click 'Generate' to create your standup report"
                          FontSize="14"
                          TextColor="Gray"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          IsVisible="{Binding LatestReport, Converter={StaticResource IsNullConverter}}" />

                    <!-- Stats -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" Margin="0,10,0,0"
                         IsVisible="{Binding LatestReport, Converter={StaticResource IsNotNullConverter}}">
                        <Border Grid.Column="0" Padding="10" StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource Primary}">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding LatestReport.CommitCount}" FontSize="24" TextColor="White" HorizontalOptions="Center" />
                                <Label Text="Commits" FontSize="12" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="10" StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource Secondary}">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding LatestReport.PullRequestCount}" FontSize="24" TextColor="White" HorizontalOptions="Center" />
                                <Label Text="PRs" FontSize="12" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" Padding="10" StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource Tertiary}">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding LatestReport.WorkItemCount}" FontSize="24" TextColor="White" HorizontalOptions="Center" />
                                <Label Text="Tasks" FontSize="12" TextColor="White" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Button Text="Generate"
                       Command="{Binding GenerateStandupCommand}"
                       IsEnabled="{Binding IsGenerating, Converter={StaticResource InvertedBoolConverter}}"
                       BackgroundColor="{StaticResource Primary}"
                       TextColor="White"
                       WidthRequest="150" />

                <Button Text="Copy"
                       Command="{Binding CopyToClipboardCommand}"
                       IsEnabled="{Binding LatestReport, Converter={StaticResource IsNotNullConverter}}"
                       BackgroundColor="Gray"
                       TextColor="White"
                       WidthRequest="100" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ActivityIndicator IsRunning="{Binding IsGenerating}" IsVisible="{Binding IsGenerating}"
                          HorizontalOptions="Center" VerticalOptions="Center" Grid.RowSpan="3" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             xmlns:entities="clr-namespace:Standup.Domain.Entities;assembly=Standup.Domain"
             x:Class="Standup.Maui.Views.GroupListPage"
             x:DataType="viewModels:GroupListViewModel"
             Title="Groups">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HorizontalStackLayout Grid.Row="0" Margin="0,0,0,15">
            <Label Text="Repository Groups" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            <Label Text="{Binding Groups.Count, StringFormat=' ({0})'}" FontSize="16" TextColor="Gray" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Groups List -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">
                <CollectionView ItemsSource="{Binding Groups}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:RepositoryGroup">
                            <Border Margin="0,5" Padding="0" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                                <VerticalStackLayout>
                                    <!-- Group Header (Always Visible) -->
                                    <Grid Padding="15" ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:GroupListViewModel}}, Path=ToggleGroupExpansionCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <!-- Default Star -->
                                        <Label Grid.Column="0" Text="★" FontSize="18" TextColor="Gold"
                                               IsVisible="{Binding IsDefault}" VerticalOptions="Center" Margin="0,0,10,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:GroupListViewModel}}, Path=SetDefaultGroupCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="0" Text="☆" FontSize="18" TextColor="Gray"
                                               IsVisible="{Binding IsDefault, Converter={StaticResource InvertedBoolConverter}}"
                                               VerticalOptions="Center" Margin="0,0,10,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:GroupListViewModel}}, Path=SetDefaultGroupCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <!-- Group Name and Info -->
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding Repositories.Count, StringFormat='{0} repos'}"
                                                       FontSize="12" TextColor="Gray" />
                                                <Label Text="{Binding Description}" FontSize="12" TextColor="DimGray"
                                                       IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Expand/Collapse Indicator -->
                                        <Label Grid.Column="2" Text="▼" FontSize="14" TextColor="Gray"
                                               VerticalOptions="Center" Margin="10,0" />

                                        <!-- Delete Button -->
                                        <Button Grid.Column="3" Text="✕" FontSize="14"
                                                BackgroundColor="Transparent" TextColor="Gray"
                                                WidthRequest="30" HeightRequest="30" Padding="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:GroupListViewModel}}, Path=DeleteGroupCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <!-- Expanded Content (Repositories) - Will be handled in code-behind -->
                                    <VerticalStackLayout x:Name="RepositoriesContainer" IsVisible="False"
                                                         Padding="15,0,15,15" Spacing="8"
                                                         BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#252525}">

                                        <!-- Repository List -->
                                        <BindableLayout.ItemsSource>
                                            <Binding Path="Repositories" />
                                        </BindableLayout.ItemsSource>

                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Add Repository Form (shown when IsAddingRepository) -->
                <Border IsVisible="{Binding IsAddingRepository}" Padding="15" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#F0F8FF, Dark=#1A2A3A}"
                        Stroke="{AppThemeBinding Light=#4A90D9, Dark=#4A90D9}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Add Repository" FontAttributes="Bold" FontSize="16" />

                        <!-- Client Code with Recent Codes -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Client Code" FontSize="12" TextColor="Gray" />
                            <Entry Placeholder="e.g., UPHT, UPREHS" Text="{Binding NewRepoClientCode}" />
                            <HorizontalStackLayout Spacing="8" IsVisible="{Binding RecentClientCodes.Count, Converter={StaticResource IntToBoolConverter}}">
                                <Label Text="Recent:" FontSize="11" TextColor="Gray" VerticalOptions="Center" />
                                <CollectionView ItemsSource="{Binding RecentClientCodes}" HeightRequest="30"
                                                ItemsLayout="HorizontalList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Padding="8,4" Margin="2,0" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#3A3A3A}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:GroupListViewModel}}, Path=SelectClientCodeCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding .}" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Source Type -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Source Type" FontSize="12" TextColor="Gray" />
                            <HorizontalStackLayout Spacing="15">
                                <RadioButton Content="Azure DevOps" GroupName="SourceType"
                                             IsChecked="{Binding NewRepoSourceType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AzureDevOps}" />
                                <RadioButton Content="GitHub" GroupName="SourceType"
                                             IsChecked="{Binding NewRepoSourceType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GitHub}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Organization -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Organization" FontSize="12" TextColor="Gray" />
                            <Entry Placeholder="e.g., UPREHS or github-org" Text="{Binding NewRepoOrganization}" />
                        </VerticalStackLayout>

                        <!-- Project (Azure DevOps only) -->
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding NewRepoSourceType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AzureDevOps}">
                            <Label Text="Project" FontSize="12" TextColor="Gray" />
                            <Entry Placeholder="Azure DevOps Project name" Text="{Binding NewRepoProject}" />
                        </VerticalStackLayout>

                        <!-- Repository -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Repository" FontSize="12" TextColor="Gray" />
                            <Entry Placeholder="Repository name" Text="{Binding NewRepoRepository}" />
                        </VerticalStackLayout>

                        <!-- PAT -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Personal Access Token (optional if org PAT exists)" FontSize="12" TextColor="Gray" />
                            <Entry Placeholder="PAT" Text="{Binding NewRepoPat}" IsPassword="True" />
                        </VerticalStackLayout>

                        <!-- Author Filter -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Author Filter (optional)" FontSize="12" TextColor="Gray" />
                            <Entry Placeholder="Email or username to filter commits" Text="{Binding NewRepoAuthorIdentifier}" />
                        </VerticalStackLayout>

                        <!-- Buttons -->
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End" Margin="0,10,0,0">
                            <Button Text="Cancel" Command="{Binding CancelAddRepositoryCommand}"
                                    BackgroundColor="Gray" TextColor="White" />
                            <Button Text="Add Repository" Command="{Binding AddRepositoryCommand}"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Add Group Form -->
        <Border Grid.Row="2" IsVisible="{Binding IsAddingGroup}" Padding="15" Margin="0,10,0,0"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Add New Group" FontAttributes="Bold" FontSize="16" />
                <Entry Placeholder="Group Name (e.g., JourneyTeam)" Text="{Binding NewGroupName}" />
                <Entry Placeholder="Description (optional)" Text="{Binding NewGroupDescription}" />
                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                    <Button Text="Cancel" Command="{Binding CancelAddGroupCommand}"
                            BackgroundColor="Gray" TextColor="White" />
                    <Button Text="Add Group" Command="{Binding AddGroupCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Add Group Button -->
        <Button Grid.Row="2" Text="+ Add Group" Command="{Binding ShowAddGroupCommand}"
                IsVisible="{Binding IsAddingGroup, Converter={StaticResource InvertedBoolConverter}}"
                HorizontalOptions="End" Margin="0,10,0,0" />

        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center" Grid.RowSpan="3" />
    </Grid>
</ContentPage>

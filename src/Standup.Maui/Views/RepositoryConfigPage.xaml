<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             x:Class="Standup.Maui.Views.RepositoryConfigPage"
             x:DataType="viewModels:RepositoryConfigViewModel"
             Title="{Binding PageTitle}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="{Binding PageTitle}" FontSize="24" FontAttributes="Bold" />
                <Label Text="Select which repositories to include in standup reports"
                       FontSize="14" TextColor="Gray"
                       IsVisible="{Binding IsGroupMode}" />
                <Label Text="Add GitHub or Azure DevOps repos to track"
                       FontSize="14" TextColor="Gray"
                       IsVisible="{Binding IsGroupMode, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Close button for modal -->
            <Button Grid.Column="1" Text="Done"
                    Command="{Binding CloseCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    VerticalOptions="Start" />
        </Grid>

        <!-- Group Mode: Selectable Project List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding SelectableProjects}"
                        Margin="0,15"
                        IsVisible="{Binding IsGroupMode}">
            <CollectionView.Header>
                <HorizontalStackLayout Spacing="10" Margin="0,0,0,10">
                    <Button Text="Toggle All"
                            Command="{Binding ToggleAllCommand}"
                            BackgroundColor="Gray"
                            TextColor="White"
                            FontSize="12"
                            Padding="10,5" />
                    <Label Text="{Binding SelectableProjects.Count, StringFormat='{0} configured projects'}"
                           VerticalOptions="Center"
                           TextColor="DimGray" />
                </HorizontalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SelectableProject">
                    <Border Margin="0,5" Padding="15"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <!-- Checkbox -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalOptions="Center" />

                            <!-- Project Info -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <HorizontalStackLayout Spacing="10">
                                    <Border Padding="5,2"
                                            StrokeShape="RoundRectangle 3"
                                            BackgroundColor="{StaticResource Primary}">
                                        <Label Text="{Binding SourceTypeDisplay}"
                                               FontSize="10"
                                               TextColor="White" />
                                    </Border>
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Client Code Entry (only show when selected) -->
                            <Entry Grid.Column="2"
                                   Placeholder="Client Code"
                                   Text="{Binding ClientCode}"
                                   WidthRequest="100"
                                   IsVisible="{Binding IsSelected}"
                                   VerticalOptions="Center" />

                            <!-- Status indicator -->
                            <Label Grid.Column="3"
                                   Text="✓"
                                   FontSize="20"
                                   TextColor="Green"
                                   IsVisible="{Binding IsSelected}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="No projects configured" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Text="Go to the Projects tab to add repositories first" FontSize="12" TextColor="DimGray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Legacy Project Mode: Repository List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Repositories}"
                        Margin="0,15"
                        IsVisible="{Binding IsGroupMode, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="15"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Padding="8" WidthRequest="60"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="{StaticResource Primary}">
                                <Label Text="{Binding SourceType}" FontSize="10" TextColor="White" HorizontalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Margin="10,0">
                                <Label Text="{Binding DisplayName, TargetNullValue={Binding Repository}}" FontAttributes="Bold" />
                                <Label Text="{Binding Organization, StringFormat='{0}/'}" FontSize="12" TextColor="Gray">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Organization}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding Project}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding Repository}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding AuthorIdentifier, StringFormat='Author: {0}'}" FontSize="11" TextColor="DimGray" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2" Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                  FontSize="12" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="No repositories configured" FontSize="16" TextColor="Gray" />
                    <Label Text="Add a repository to get started" FontSize="12" TextColor="DimGray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Add Repository Form (Legacy mode only) -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsAddingRepository}"
                Padding="15"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Add Repository" FontAttributes="Bold" FontSize="16" />

                <Picker Title="Source Type" SelectedItem="{Binding NewSourceType}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>GitHub</x:String>
                            <x:String>AzureDevOps</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Entry Placeholder="Organization" Text="{Binding NewOrganization}" />
                <Entry Placeholder="Project (Azure DevOps only)" Text="{Binding NewProject}" />
                <Entry Placeholder="Repository Name" Text="{Binding NewRepository}" />
                <Entry Placeholder="Author Identifier (username/email)" Text="{Binding NewAuthorIdentifier}" />
                <Entry Placeholder="Personal Access Token (optional)" Text="{Binding NewPat}" IsPassword="True" />

                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                    <Button Text="Cancel" Command="{Binding CancelAddRepositoryCommand}"
                           BackgroundColor="Gray" TextColor="White" />
                    <Button Text="Add" Command="{Binding AddRepositoryCommand}"
                           BackgroundColor="{StaticResource Primary}" TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Status and Add button (Legacy mode only) -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding IsGroupMode, Converter={StaticResource InvertedBoolConverter}}">
            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
            <Button Text="+ Add Repository"
                    Command="{Binding ShowAddRepositoryCommand}"
                    HorizontalOptions="End"
                    IsVisible="{Binding IsAddingRepository, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>

        <!-- Status message (Group mode) -->
        <Label Grid.Row="2"
               Text="{Binding StatusMessage}"
               FontSize="12"
               TextColor="Green"
               HorizontalOptions="Center"
               Margin="0,10"
               IsVisible="{Binding IsGroupMode}" />

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                          HorizontalOptions="Center" VerticalOptions="Center" Grid.RowSpan="3" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Standup.Application.ViewModels;assembly=Standup.Application"
             x:Class="Standup.Maui.Views.Components.SettingsTabView"
             x:DataType="viewModels:SettingsViewModel">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Label Text="Application Settings" FontSize="24" FontAttributes="Bold" />
            <Label Text="Configure global settings for the application" FontSize="12" TextColor="Gray" />

            <!-- AI Configuration -->
            <Border Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1E3A4C}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🤖 AI Summary Configuration" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Configure Azure OpenAI / AI Foundry for generating standup summaries" FontSize="12" TextColor="Gray" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Azure OpenAI Endpoint" FontSize="12" TextColor="Gray" />
                        <Entry Text="{Binding AiEndpoint}" Placeholder="https://your-resource.openai.azure.com/" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Deployment Name" FontSize="12" TextColor="Gray" />
                        <Entry Text="{Binding AiDeploymentName}" Placeholder="gpt-4o" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="API Key (optional - leave empty to use your Azure login)" FontSize="12" TextColor="Gray" />
                        <Entry Text="{Binding AiApiKey}" Placeholder="Leave empty to use Azure Identity" IsPassword="True" />
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Auth Method:" FontSize="11" TextColor="DimGray" VerticalOptions="Center" />
                            <Label Text="{Binding AuthMethodDisplay}" FontSize="11" TextColor="{Binding AuthMethodColor}" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Validation Result -->
                    <Label Text="{Binding AiValidationResult}"
                           FontSize="12"
                           TextColor="{Binding AiValidationSuccess, Converter={StaticResource BoolToColorConverter}}"
                           IsVisible="{Binding AiValidationResult, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                    <!-- Action Buttons -->
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Validate"
                               Command="{Binding ValidateAIConnectionCommand}"
                               BackgroundColor="#8B5CF6"
                               TextColor="White"
                               WidthRequest="100"
                               IsEnabled="{Binding IsValidatingAI, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Text="Save AI Settings"
                               Command="{Binding SaveAISettingsCommand}"
                               BackgroundColor="#10B981"
                               TextColor="White"
                               WidthRequest="140" />
                        <ActivityIndicator IsRunning="{Binding IsValidatingAI}"
                                          IsVisible="{Binding IsValidatingAI}"
                                          HeightRequest="20"
                                          WidthRequest="20"
                                          VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Cache Management -->
            <Border Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📦 Cache Management" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Manage cached standup reports" FontSize="12" TextColor="Gray" />

                    <HorizontalStackLayout Spacing="15">
                        <VerticalStackLayout>
                            <Label Text="Cached Reports" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding CacheEntryCount, StringFormat='{0} reports'}" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Cache Size" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding CacheSizeDisplay}" FontSize="14" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Button Text="Clear Cache"
                           Command="{Binding ClearCacheCommand}"
                           BackgroundColor="#EF4444"
                           TextColor="White"
                           HorizontalOptions="Start"
                           WidthRequest="120" />
                </VerticalStackLayout>
            </Border>

            <!-- Integrations -->
            <Border Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🔌 Integrations" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Optional integrations to enhance standup reports with additional context" FontSize="12" TextColor="Gray" />

                    <Label Text="Configure external integrations like CRM projects, Office 365 emails, and more to add rich context to your standup reports. Integrations are optional and can be enabled per group." FontSize="12" TextColor="Gray" />

                    <Label Text="Available integrations:" FontSize="12" FontAttributes="Bold" />
                    <Label Text="• CRM Project Integration - Dynamics 365 project context, timelines, and milestones" FontSize="11" TextColor="Gray" Margin="10,0,0,0" />
                    <Label Text="• Office 365 Email Integration - Client email summaries and AI-generated tasks" FontSize="11" TextColor="Gray" Margin="10,0,0,0" />
                    <Label Text="• Office 365 Calendar - Meeting summaries and schedule context" FontSize="11" TextColor="Gray" Margin="10,0,0,0" />
                    <Label Text="• Microsoft Teams - Teams activity and channel summaries" FontSize="11" TextColor="Gray" Margin="10,0,0,0" />

                    <Label Text="Coming Soon: Integration configuration will be available in a future update." FontSize="12" TextColor="#F59E0B" FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <!-- About Section -->
            <Border Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ℹ️ About" FontAttributes="Bold" FontSize="16" />
                    <Label Text="StandBot - Standup Automation Platform" FontSize="14" />
                    <Label Text="Collects work activity from GitHub/Azure DevOps, summarizes with AI, and delivers via Teams/email." FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding AppVersion, StringFormat='Version: {0}'}" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="Green" HorizontalOptions="Center" />

            <Button Text="Save Settings"
                   Command="{Binding SaveCommand}"
                   BackgroundColor="#3B82F6"
                   TextColor="White"
                   HorizontalOptions="Center"
                   WidthRequest="200" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>

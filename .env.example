# API Keys (Required to enable respective provider)
# Copy this file to .env and fill in your actual API keys

ANTHROPIC_API_KEY=""       # Required for Claude models
PERPLEXITY_API_KEY=""      # Optional for research features
OPENAI_API_KEY=""          # Optional for OpenAI models
GOOGLE_API_KEY=""          # Optional for Google Gemini models
MISTRAL_API_KEY=""         # Optional for Mistral AI models
XAI_API_KEY=""             # Optional for xAI models
GROQ_API_KEY=""            # Optional for Groq models
OPENROUTER_API_KEY=""      # Optional for OpenRouter models
AZURE_OPENAI_API_KEY=""    # Optional for Azure OpenAI models
OLLAMA_API_KEY=""          # Optional for remote Ollama servers
GITHUB_API_KEY=""          # Optional for GitHub import/export
